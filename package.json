{
  "name": "codex-loop",
  "version": "0.1.0",
  "description": "Local Codex SDK implementation/review/repair loop for one repo and one task.",
  "type": "module",
  "bin": {
    "codex-loop": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/cli.ts",
    "smoke": "tsx src/cli.ts --help"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@openai/codex-sdk": "^0.137.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
